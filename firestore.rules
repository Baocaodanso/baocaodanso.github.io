rules_version = '2';
// Mẫu quy tắc bảo mật Firestore: chỉ tài khoản có email trong danh sách mới đọc/ghi được.
// Thay email bên dưới bằng email của cán bộ tổng hợp, rồi dán vào Firebase Console → Firestore → Rules.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if request.auth != null
        && request.auth.token.email in ['canbo@example.com'];
    }
  }
}
