rules_version = '2';
// Quy tắc bảo mật Firestore: chỉ các tài khoản có email trong danh sách mới đọc/ghi được.
// Dán toàn bộ nội dung này vào Firebase Console → Firestore Database → Rules → Publish.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if request.auth != null
        && request.auth.token.email in ['trangngoc59@gmail.com', 'qtrang008@gmail.com'];
    }
  }
}
